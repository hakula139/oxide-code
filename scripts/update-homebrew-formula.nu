#!/usr/bin/env nu

use std-rfc/str

# Regenerate the Homebrew formula from a release's checksum sidecars.
def main [
  tag: string # Release tag, including the v prefix
  sidecars: string # Directory containing the release's .sha256 files
] {
  let version = $tag | str replace --regex '^v' ''
  let base = $"https://github.com/hakula139/oxide-code/releases/download/($tag)"
  let mac_arm_sha = open --raw ($sidecars | path join 'oxide-code-aarch64-apple-darwin.sha256')
    | split words
    | first
  let linux_x86_sha = open --raw ($sidecars | path join 'oxide-code-x86_64-unknown-linux-gnu.sha256')
    | split words
    | first

  let template = (
    r#'
    # Regenerated by scripts/update-homebrew-formula.nu for each release the formula follows.
    # Edit that script, not this file, when the formula's structure needs to change.

    class OxideCode < Formula
      desc "Terminal-based AI coding assistant written in Rust"
      homepage "https://github.com/hakula139/oxide-code"
      url "{{base}}/oxide-code-x86_64-unknown-linux-gnu.tar.gz"
      version "{{version}}"
      sha256 "{{linux_x86_sha}}"
      license "MIT"

      # Every platform needs a URL for the arch requirements below to load and report.
      on_macos do
        depends_on arch: :arm64
        depends_on macos: :monterey

        on_arm do
          url "{{base}}/oxide-code-aarch64-apple-darwin.tar.gz"
          sha256 "{{mac_arm_sha}}"
        end
      end

      on_linux do
        depends_on arch: :x86_64
      end

      def install
        bin.install "ox"
        doc.install "LICENSE", "THIRD-PARTY-NOTICES"
      end

      test do
        assert_match version.to_s, shell_output("#{bin}/ox --version")
      end
    end

    '#
    | str dedent
  )

  $template
    | str replace --all '{{base}}' $base
    | str replace --all '{{version}}' $version
    | str replace --all '{{linux_x86_sha}}' $linux_x86_sha
    | str replace --all '{{mac_arm_sha}}' $mac_arm_sha
    | save --force Formula/oxide-code.rb

  print $"Updated Formula/oxide-code.rb to ($tag)"
}
