{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "incremental": false,
  "includes": ["**/*.md"],
  "excludes": [".direnv/**", "node_modules/**", "target/**"],
  "markdown": {
    "emphasisKind": "underscores",
    "strongKind": "asterisks"
  },
  "plugins": ["https://plugins.dprint.dev/markdown-0.26.0.wasm"]
}
