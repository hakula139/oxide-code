[
    "Help",
    "",
    "Commands",
    "",
    "/archive [<id-prefix>]            Archive this session or a saved one",
    "/clear (new, reset)               Start a new session (this one stays resumable)",
    "/compact [<instructions>]         Compress conversation context into a summary",
    "/config                           Show resolved config",
    "/delete <id-prefix>               Delete a saved session",
    "/diff                             Show uncommitted working-tree changes",
    "/effort [<level>]                 Adjust reasoning effort",
    "/exit (quit)                      Quit oxide-code",
    "/help                             List slash commands",
    "/init [<file>]                    Create or update AGENTS.md / CLAUDE.md",
    "/login                            Sign in to a Claude account",
    "/logout                           Sign out of the oxide-code login",
    "/mode [<mode>]                    Switch the permission mode",
    "/model [<id>]                     Switch the model",
    "/rename [<title>]                 Rename the current session",
    "/resume (continue) [<id-prefix>]  Resume a previous session",
    "/status                           Show current session info",
    "/theme [<name>]                   Change the theme",
    "/unarchive <id-prefix>            Unarchive a saved session",
    "",
    "Keys",
    "",
    "Tab / Shift+Tab                   Switch the permission mode",
    "Esc                               Stop the running turn",
    "Ctrl+O                            Expand or collapse long output",
    "Ctrl+C twice                      Exit, even with a draft",
    "Ctrl+D twice                      Exit with an empty input",
    "//                                Send text that starts with a slash",
