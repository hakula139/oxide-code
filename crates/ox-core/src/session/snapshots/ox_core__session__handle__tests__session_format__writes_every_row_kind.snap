---
source: crates/ox-core/src/session/handle.rs
expression: sql_dump(&store)
---
PRAGMA user_version = 1;
CREATE TABLE sessions (
    id             TEXT PRIMARY KEY,
    forked_from    TEXT,
    project_root   TEXT NOT NULL,
    cwd            TEXT NOT NULL,
    git_branch     TEXT,
    model          TEXT NOT NULL,
    format         INTEGER NOT NULL,
    created_at     INTEGER NOT NULL,
    updated_at     INTEGER NOT NULL,
    title          TEXT,
    title_manual   INTEGER NOT NULL,
    archived_at    INTEGER,
    head_id        TEXT,
    message_count  INTEGER NOT NULL,
    file_snapshots TEXT
) STRICT;
CREATE INDEX sessions_by_project ON sessions (project_root, updated_at DESC);
CREATE TABLE messages (
    seq           INTEGER PRIMARY KEY,
    session_id    TEXT NOT NULL REFERENCES sessions (id) ON DELETE CASCADE,
    id            TEXT NOT NULL,
    parent_id     TEXT,
    role          TEXT NOT NULL,
    content       TEXT NOT NULL,
    context       TEXT,
    compact       TEXT,
    tool_metadata TEXT,
    created_at    INTEGER NOT NULL,
    UNIQUE (session_id, id),
    FOREIGN KEY (session_id, parent_id) REFERENCES messages (session_id, id)
) STRICT;
CREATE TABLE usage (
    id         TEXT PRIMARY KEY,
    session_id TEXT NOT NULL REFERENCES sessions (id) ON DELETE CASCADE,
    record     TEXT NOT NULL,
    created_at INTEGER NOT NULL
) STRICT;
CREATE INDEX usage_by_session ON usage (session_id);
