{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>hakula139/devkit#61682dd34d15732234bac835f3603de8de5b86f1"],
  "packageRules": [
    {
      "matchManagers": ["rust-toolchain"],
      "groupName": "flake inputs",
      "semanticCommitScope": "flake",
      "automerge": true
    },
    {
      "description": "Matches the unicode-width bound in Cargo.toml, which explains it.",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["unicode-width"],
      "allowedVersions": "<0.2.3"
    }
  ]
}
